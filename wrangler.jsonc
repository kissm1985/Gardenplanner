// Cloudflare Workers (static assets): the built app from dist/ for closed testing behind Cloudflare Access.
// Build: npm run build · Deploy: npx wrangler deploy (see docs/TESZTELES.md). The name must match the Worker.
{
  "name": "planterra",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
