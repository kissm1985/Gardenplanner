{
  "name": "kerttervezo",
  "private": true,
  "author": "Kiss-Mihály István",
  "license": "UNLICENSED",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/licenses.mjs && vite",
    "build": "node scripts/licenses.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-size.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "server": "tsx server/main.ts",
    "server:cli": "tsx server/cli.ts",
    "deploy:test": "npm run build && npx --yes wrangler@4 deploy",
    "verify:render": "npm run build && tsx scripts/verify-render.ts",
    "guide:shots": "node scripts/guide-shots.mjs hu && node scripts/guide-shots.mjs en"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
